# Sirve el frontend y hace de proxy hacia el backend Go.
#
# El backend no sabe nada del frontend y no tiene CORS: al exponer ambos bajo
# el mismo origen (mismo host y puerto), el navegador no necesita CORS.
# Backend y frontend siguen siendo dos despliegues independientes.

{
	admin off
	auto_https off
}

:8081 {
	encode gzip

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:host.docker.internal:8080}
	}

	handle /health {
		reverse_proxy {$BACKEND_UPSTREAM:host.docker.internal:8080}
	}

	handle {
		root * {$SITE_ROOT:/srv}
		try_files {path} /index.html
		file_server

		# La v1 cambia a menudo: sin caché para no pelearse con el móvil.
		header Cache-Control "no-store"
	}
}
